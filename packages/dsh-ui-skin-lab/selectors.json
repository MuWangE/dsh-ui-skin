  "force": [
    {
      "id": "motion-off",
      "selector": "html[data-dsu-skin][data-dsu-motion=\"off\"]",
      "purpose": "手动「停用动效」：transition / animation / scroll-behavior 全部压平",
      "reason": "官方过渡是硬编码的，CSS 变量表达不了时长与曲线，整体压制是唯一手段。作用域仅限用户主动关掉时。"
    },
    {
      "id": "reduced-motion-system",
      "selector": "html[data-dsu-skin]",
      "scope": "reduced-motion",
      "purpose": "系统 prefers-reduced-motion: reduce 时整页降级",
      "reason": "标准媒体查询降级，只在该媒体块内生效。"
    },
    {
      "id": "pixel-hardcut",
      "selector": "html[data-dsu-skin=\"pixel\"]",
      "purpose": "pixel 预设 0ms：只压 transition + scroll-behavior",
      "reason": "DESIGN §6 承诺。刻意不压 animation——spinner / 状态点 / 骨架屏 / 打字指示点在压掉后会静止，那是功能损失。"
    }
  ]
